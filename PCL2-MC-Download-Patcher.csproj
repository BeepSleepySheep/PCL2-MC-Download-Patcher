<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <AssemblyName>PCL2-MC-Download-Patcher</AssemblyName>
    <RootNamespace>PCL2McDownloadPatcher</RootNamespace>
    <Version>1.0.0</Version>
    <Product>PCL2 MC Download Patcher</Product>
    <Description>Restore the disabled Minecraft download features in PCL2 by rewriting the affected IL in place.</Description>
    <Copyright>Copyright (c) 2026 PCL2-MC-Download-Patcher contributors</Copyright>

    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="dnlib" Version="4.5.0" />
  </ItemGroup>

</Project>

